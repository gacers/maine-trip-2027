# Google service account with access to the Sheets and Docs APIs (the
# trip export Sheet and the itinerary export Doc are both shared with
# this service account's email as an Editor once created — see
# lib/drive.ts for why a plain service account can't create the file
# itself).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Optional — powers the "Google connections" panel on /settings (see
# lib/googleCredentialHealth.ts) pushing a rotated credential straight
# into this project's own Vercel env vars + redeploying, instead of
# hand-navigating Vercel's dashboard. VERCEL_API_TOKEN from
# vercel.com/account/tokens; VERCEL_PROJECT_ID from this project's own
# Settings tab on vercel.com. VERCEL_TEAM_ID only if this project lives
# under a team rather than a personal account. Without these set, the
# health checks above still work — only the push-a-new-value buttons
# are disabled.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Optional — a *separate* Google Cloud service account, narrowly scoped
# to mint replacement keys for the credentials above (never given
# Owner/Editor on the whole project): Service Account Key Admin scoped
# to just the GOOGLE_SERVICE_ACCOUNT_EMAIL identity above, plus API Keys
# Admin (Google has no finer scope for that one). This is the single
# most sensitive credential in the app, since its whole job is minting
# replacements for every other one — treat it accordingly.
GOOGLE_KEY_ADMIN_SERVICE_ACCOUNT_EMAIL=
GOOGLE_KEY_ADMIN_SERVICE_ACCOUNT_PRIVATE_KEY=

# A real Google account's OAuth2 credentials, used only to actually
# create the export Sheet/Doc in Drive (a service account has zero
# Drive storage quota, so it can't own a file even inside a folder
# shared with it — see lib/drive.ts). One-time setup: authorize this
# app for that account's Drive scope, capture the refresh token.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Public site URL, used to build the "siteLink" column back to each
# listing's anchor on the page, and invite links in outbound email.
# Set to the real production URL once deployed.
NEXT_PUBLIC_SITE_URL=

# Resend (https://resend.com) — sends trip invite emails from the admin
# Invite Links UI. Create an API key in the dashboard, then verify your
# sending domain (DNS records) so RESEND_FROM_EMAIL can use it. Until
# the domain is verified, Resend only delivers to your own account
# email when using their test sender.
RESEND_API_KEY=
# Friendly-name form is fine; quote the value if it includes spaces/<>:
# RESEND_FROM_EMAIL="Trip Planner <invites@yourdomain.com>"
RESEND_FROM_EMAIL=

# Google Maps JavaScript API key, used client-side for the live embedded
# map + real driving routes on each listing card. This is meant to be
# public (Next.js inlines NEXT_PUBLIC_ vars into the browser bundle) —
# restrict abuse via HTTP referrer restrictions in Google Cloud Console
# instead of trying to keep it secret. Needs the Maps JavaScript API and
# Places API (New) enabled, with billing on (a generous free monthly
# call allowance per API should cover this app's usage).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# A separate, server-only Google Maps key for the itinerary's drive-time
# connectors (see lib/routeCache.ts) — called from the API route, never
# sent to the browser, so restrict it by IP (or leave unrestricted; it
# never leaves the server either way) rather than HTTP referrer, which
# only makes sense for a browser-side key. Needs just the Directions API
# enabled. Kept separate from the key above on purpose: that one MUST
# stay referrer-restricted since it's public, and a key can't carry both
# an HTTP-referrer restriction and be usable from a server at the same
# time. Every route computed through this key is cached in the
# route_cache table (see the migration of the same name) — the ordinary
# case after this app has been used a while is close to zero calls
# through this key at all, since most stop-pairs get reused.
GOOGLE_MAPS_SERVER_API_KEY=
