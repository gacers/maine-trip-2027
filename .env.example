# Preferred: base64 of the entire service-account JSON key file (avoids
# newline/quote issues from pasting a multi-line PEM key). If set, this
# takes priority over the two separate vars below.
GOOGLE_SERVICE_ACCOUNT_JSON_B64=

# Google service account with access to Sheets API, and the target Sheet
# shared with that service account's email as an Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Public site URL, used to build the "siteLink" column back to each
# listing's anchor on the page. Set to the real Vercel URL once deployed.
NEXT_PUBLIC_SITE_URL=

# Google Maps JavaScript API key, used client-side for the live embedded
# map + real driving routes on each listing card. This is meant to be
# public (Next.js inlines NEXT_PUBLIC_ vars into the browser bundle) —
# restrict abuse via HTTP referrer restrictions in Google Cloud Console
# instead of trying to keep it secret. Needs the Maps JavaScript API and
# Directions API enabled, with billing on (small free monthly credit
# should cover this app's usage).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
