# Google service account with access to the Sheets and Docs APIs (the
# trip export Sheet and the itinerary export Doc are both shared with
# this service account's email as an Editor once created — see
# lib/drive.ts for why a plain service account can't create the file
# itself).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# A real Google account's OAuth2 credentials, used only to actually
# create the export Sheet/Doc in Drive (a service account has zero
# Drive storage quota, so it can't own a file even inside a folder
# shared with it — see lib/drive.ts). One-time setup: authorize this
# app for that account's Drive scope, capture the refresh token.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Public site URL, used to build the "siteLink" column back to each
# listing's anchor on the page. Set to the real Vercel URL once deployed.
NEXT_PUBLIC_SITE_URL=

# Google Maps JavaScript API key, used client-side for the live embedded
# map + real driving routes on each listing card, and the itinerary's
# own drive-time connectors. This is meant to be public (Next.js inlines
# NEXT_PUBLIC_ vars into the browser bundle) — restrict abuse via HTTP
# referrer restrictions in Google Cloud Console instead of trying to
# keep it secret. Needs the Maps JavaScript API, Places API (New), and
# Directions API enabled, with billing on (a generous free monthly call
# allowance per API should cover this app's usage).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
